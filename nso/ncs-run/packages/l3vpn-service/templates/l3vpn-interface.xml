<config-template xmlns="http://tail-f.com/ns/config/1.0">
  <devices xmlns="http://tail-f.com/ns/ncs">
    <device>
      <name>{/device-name}</name>
      <config>
        <interface xmlns="http://tail-f.com/ned/cisco-ios-xr">
          <?if {/interface/interface-type = 'GigabitEthernet'}?>
          <GigabitEthernet-subinterface>
            <GigabitEthernet>
              <id>{$INTF_ID}</id>
              <description>{/interface/description}</description>
              <bandwidth>{/bandwidth}</bandwidth>
              <encapsulation>
                <dot1q>
                  <vlan-id>{/interface/svlan}</vlan-id>
                  <second-dot1q>{/interface/cvlan}</second-dot1q>
                </dot1q>
              </encapsulation>
              <service-policy>
                <input>
                  <name>{/qos/in-policy-name}</name>
                </input>
                <output>
                  <name>{/qos/out-policy-name}</name>
                </output>
              </service-policy>
              <vrf>{/vrf/vrf-name}</vrf>
              <ipv4>
                <address>
                  <ip>{/interface/ip-address}</ip>
                  <mask>{/interface/subnet-mask}</mask>
                </address>
                <verify>
                  <unicast>
                    <source>
                      <reachable-via>any</reachable-via>
                      <allow-self-ping/>
                      <allow-default/>
                    </source>
                  </unicast>
                </verify>
                <unreachables>
                  <disable/>
                </unreachables>
              </ipv4>
              <?if {$IPV6_ENABLE = 'true'}?>
              <ipv6>
                <verify>
                  <unicast>
                    <source>
                      <reachable-via>any</reachable-via>
                      <allow-default/>
                      <allow-self-ping/>
                    </source>
                  </unicast>
                </verify>
                <address>
                  <prefix-list>
                    <prefix>{/interface/ipv6-address}</prefix>
                  </prefix-list>
                </address>
                <unreachables>
                  <disable/>
                </unreachables>
              </ipv6>
              <?end?>
            </GigabitEthernet>
          </GigabitEthernet-subinterface>
          <?end?>
        </interface>
      </config>
    </device>
  </devices>
</config-template>