<config-template xmlns="http://tail-f.com/ns/config/1.0">
  <devices xmlns="http://tail-f.com/ns/ncs">
    <device>
      <name>{/device-name}</name>
      <config>
        <policy-map xmlns="http://tail-f.com/ned/cisco-ios-xr">
          <name>{/qos/in-policy-name}</name>
          <class>
            <class-default>
              <map>class-default</map>
              <police-rate-unit>
                <police>
                  <rate>
                    <cir>{$POLICE_RATE_BPS}</cir>
                    <cir-unit>bps</cir-unit>
                    <burst>{$BURST_BYTES}</burst>
                    <burst-units>bytes</burst-units>
                    <peak-burst>{$PEAK_BURST_BYTES}</peak-burst>
                    <peak-burst-units>bytes</peak-burst-units>
                    <conform-action>
                      <set>
                        <mpls>
                          <experimental>
                            <imposition>{/qos/mpls-exp}</imposition>
                          </experimental>
                        </mpls>
                      </set>
                      <transmit/>
                    </conform-action>
                    <exceed-action>
                      <drop/>
                    </exceed-action>
                  </rate>
                </police>
              </police-rate-unit>
            </class-default>
          </class>
        </policy-map>
        <policy-map xmlns="http://tail-f.com/ned/cisco-ios-xr">
          <name>{/qos/out-policy-name}</name>
          <class>
            <class-default>
              <map>class-default</map>
              <shape>
                <average>
                  <rate>{$SHAPE_RATE_BPS}</rate>
                  <rate-unit>bps</rate-unit>
                </average>
              </shape>
            </class-default>
          </class>
        </policy-map>
      </config>
    </device>
  </devices>
</config-template>